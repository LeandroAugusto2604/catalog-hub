# Copie este arquivo para .env na sua VPS e preencha os valores.
# NUNCA envie o .env preenchido para o Git.

# ---- Backend (banco de dados, login, fotos) ----
# Valores do SEU projeto Supabase: Project Settings -> API
SUPABASE_URL="https://SEU-PROJETO.supabase.co"
SUPABASE_PUBLISHABLE_KEY="cole-aqui-a-chave-anon-publishable"
SUPABASE_SERVICE_ROLE_KEY="cole-aqui-a-chave-service-role"

# Mesmas informações usadas pelo site no navegador
VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="cole-aqui-a-chave-anon-publishable"
VITE_SUPABASE_PROJECT_ID="seu-projeto-id"

# ---- Envio de e-mail dos orçamentos (SMTP) ----
SMTP_HOST="smtp.seuprovedor.com"
SMTP_PORT="587"
SMTP_SECURE="false"          # use "true" se a porta for 465
SMTP_USER="seu-usuario-smtp"
SMTP_PASS="sua-senha-smtp"
SMTP_FROM="Catálogo <noreply@tudotop.dev-prod.cloud>"
ADMIN_EMAIL="leandro_cjc@hotmail.com"

# ---- Servidor ----
PORT="3000"
NODE_ENV="production"
