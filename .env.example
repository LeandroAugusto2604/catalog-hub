# Copie para .env na VPS:  cp .env.example .env  &&  nano .env
# NUNCA envie o .env preenchido para o GitHub.

# ---- Banco de dados / login / fotos (seu projeto Supabase) ----
# Painel do Supabase -> Project Settings -> API
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Mesmos valores usados pelo site no navegador (o ID fica dentro da URL)
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_PROJECT_ID=""

# ---- Servidor ----
PORT="3000"
NODE_ENV="production"
SITE_URL="https://tudotop.dev-prod.cloud"

# ---- E-mail dos orçamentos (opcional agora) ----
# Enquanto estiver em branco, o orçamento é salvo normalmente no painel
# e nenhum e-mail é enviado. Preencha quando tiver um serviço de e-mail.
ADMIN_EMAIL="leandro_cjc@hotmail.com"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"          # "true" se a porta for 465
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Catálogo <noreply@tudotop.dev-prod.cloud>"
